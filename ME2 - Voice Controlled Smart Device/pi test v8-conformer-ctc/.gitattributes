# v8 neural checkpoint is large (43 MB) -> Git LFS.
models/best.pt filter=lfs diff=lfs merge=lfs -text
models_neg/best.pt filter=lfs diff=lfs merge=lfs -text
# ONNX exports: the .onnx holds the graph, weights live in the sibling
# .onnx.data (external data) -- track both via LFS.
models/best.onnx filter=lfs diff=lfs merge=lfs -text
models/best.onnx.data filter=lfs diff=lfs merge=lfs -text
models_neg/best.onnx filter=lfs diff=lfs merge=lfs -text
models_neg/best.onnx.data filter=lfs diff=lfs merge=lfs -text
